{
  "name": "cf-blog-admin",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "bench:render": "tsx scripts/bench-render.ts",
    "deploy": "wrangler deploy --minify",
    "deploy:ci": "wrangler d1 migrations apply blog-db --remote && npm run deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.144.0"
  }
}
