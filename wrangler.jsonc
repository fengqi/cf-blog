/**
 * 后台 Worker 配置 —— 对应 docs/design.md §7.1
 *
 * 注意：这是**唯一**的 Worker，只服务后台（admin 子域名）。
 * 前台由 R2 自定义域名直出，不经过 Worker，所以这里**故意不配 assets 绑定**。
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-blog-admin",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	/**
	 * 资源绑定（见 docs/design.md §7.1 / §12.1）
	 *
	 * 绑定名即代码里的 c.env.<名字>，统一用 UPPER_SNAKE。
	 * 改名不影响已创建的资源 —— 真正生效的是 database_name / bucket_name / id。
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog-db",
			"database_id": "db93b235-4ad8-4391-8e4c-1e9a82473f07"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "blog-content",
			"binding": "BUCKET"
		}
	],
	"kv_namespaces": [
		{
			"binding": "LOGIN_KV",
			"id": "11b1f3eab4b24348bd94d03d9e449313"
		}
	],
	/**
	 * 自定义域名：admin-blog.fengqi.me
	 * 这个不在配置文件里配，要去 Cloudflare 控制台的
	 * Workers → 该 Worker → Settings → Domains & Routes 添加（见 docs/design.md §12.1）
	 * 顺序要求：先确认 R2 自定义域名生效，再配这个。
	 */
	/**
	 * Cron Triggers（见 docs/design.md §12.3）
	 * 每小时一次，顺序做两件事：
	 *   ① 发布到点的定时文章（status='waiting' AND created <= now）
	 *   ② 扫 needs_sync = 1 的内容补发（D1 与 R2 的一致性兜底，§6.2）
	 * 免费版账号共 5 个额度，这里只用 1 个。注意 Cron 调用按请求计费（每小时 1 次可忽略）。
	 */
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}