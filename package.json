{
  "name": "cf-blog-admin",
  "type": "module",
  "scripts": {
    "dev": "npx wrangler dev",
    "preview:r2": "npx wrangler dev -c wrangler.preview.jsonc --port 8790",
    "rebuild:local": "tsx scripts/rebuild-local.ts",
    "typecheck": "tsc --noEmit",
    "build:assets": "tsx scripts/build-assets.ts",
    "bench:render": "tsx scripts/bench-render.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "deploy": "npx wrangler deploy --minify",
    "publish:prod": "tsx scripts/publish-full.ts",
    "deploy:ci": "npm run build:assets && npx wrangler d1 migrations apply blog-db --remote && npm run deploy",
    "cf-typegen": "npx wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.11",
    "markdown-it": "^15.0.2",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.144.0"
  }
}
